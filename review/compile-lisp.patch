diff --git a/Makefile b/Makefile
index 128c099..e5665d8 100644
--- a/Makefile
+++ b/Makefile
@@ -12,7 +12,5 @@
 .PHONY: packages test
-packages: ## byte-compile lib/ submodules; write lib/load-path.el, lib/autoloads.el
-	$(EMACS) -Q --batch -l scripts/build-packages.el -f build-packages-batch
-
-# make test runs in an empty temporary HOME, so no test can write to the real one
-# (D-104); REAL_HOME=1 runs in yours, as a hand run of the test files does.
+# make packages and make test run in an empty temporary HOME, so neither a module
+# the compiler loads (a file's `require's run at compile time) nor a test can write
+# to the real one (D-104); REAL_HOME=1 runs in yours, as a hand run does.
 REAL_HOME ?=
@@ -22,5 +20,20 @@
 HOME_CHECK = --eval "(when (file-equal-p \"~\" (concat \"~\" (user-login-name))) \
-	(error \"make test: HOME is the real home, %s; it should be a temporary directory (D-104)\" \
+	(error \"make: HOME is the real home, %s; it should be a temporary directory (D-104)\" \
 	(expand-file-name \"~\")))"
 endif
+# $(call temp-home,NAME,COMMAND): COMMAND with HOME set to a fresh directory,
+# removed when it ends.
+temp-home = home=$$(mktemp -d "$${TMPDIR:-/tmp}/emacs-cpp-$(1)-home.XXXXXX") || exit 1; \
+	trap 'rm -rf "$$home"' EXIT; trap 'exit 130' INT TERM; \
+	echo "make $(1): HOME=$$home"; \
+	HOME="$$home" $(2)
+
+BUILD = $(EMACS) -Q --batch $(HOME_CHECK) -l scripts/build-packages.el -f build-packages-batch
+
+packages: ## byte-compile lib/ and lisp/ in a temporary HOME; write lib/load-path.el, lib/autoloads.el
+ifeq ($(REAL_HOME),)
+	@$(call temp-home,packages,$(BUILD))
+else
+	$(BUILD)
+endif
 ERT = $(EMACS) -Q --batch $(HOME_CHECK) -L scripts -L lisp -L test \
@@ -32,6 +45,3 @@
 ifeq ($(REAL_HOME),)
-	@home=$$(mktemp -d "$${TMPDIR:-/tmp}/emacs-cpp-test-home.XXXXXX") || exit 1; \
