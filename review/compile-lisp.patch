diff --git a/scripts/build-packages.el b/scripts/build-packages.el
index 818a535..238cc8f 100644
--- a/scripts/build-packages.el
+++ b/scripts/build-packages.el
@@ -32,2 +32,8 @@
 ;; applied (a second `make packages') are taken out and applied again.
+;;
+;; The configuration's own modules in lisp/ are byte-compiled after lib/, with init.el's
+;; prelude in force (the generated load path and autoloads, use-package's settings, the
+;; platform defaults) and every warning counted as an error: a free variable or an
+;; unknown function in own code is a defect, not noise.  `require' then loads the .elc,
+;; and native compilation picks them up at startup as it does the packages'.
 
@@ -388,4 +394,62 @@
 
+;;;; The configuration's own modules
+
+(defconst build-packages-lisp-dir "lisp"
+  "The directory of the configuration's own modules, relative to the root.")
+
+(defun build-packages-lisp-files (root)
+  "Return the absolute .el files of lisp/ under ROOT, in `directory-files' order."
+  (directory-files (expand-file-name build-packages-lisp-dir root) t "\\.el\\'"))
+
+(defun build-packages-init-form (root name)
+  "Return the top-level form of init.el under ROOT that starts with (defun NAME."
+  (with-temp-buffer
+    (insert-file-contents (expand-file-name "init.el" root))
+    (goto-char (point-min))
+    (unless (re-search-forward (concat "^(defun " (regexp-quote name) " ") nil t)
+      (error "build-packages: no (defun %s ...) in init.el" name))
+    (goto-char (match-beginning 0))
+    (read (current-buffer))))
+
+(defun build-packages-lisp-prelude (root)
+  "Put init.el's part before its first module in force, for compiling lisp/.
+The root, the generated load path and autoloads, use-package's settings and the
+platform defaults, as init.el sets them; `emacs-cpp-defaults-feature' is read from
+init.el, so the platform mapping has one source (D-055)."
+  (defvar emacs-cpp-root)
+  (defvar use-package-always-defer)
+  (defvar use-package-expand-minimally)
+  (setq emacs-cpp-root (file-name-as-directory root))
+  (load (expand-file-name "lib/load-path.el" root) nil t)
+  (load (expand-file-name "lib/autoloads.el" root) nil t)
+  (add-to-list 'load-path (expand-file-name build-packages-lisp-dir root))
+  (require 'use-package)
+  (setq use-package-always-defer t
+        use-package-expand-minimally t)
+  (eval (build-packages-init-form root "emacs-cpp-defaults-feature") t)
+  (require (funcall 'emacs-cpp-defaults-feature system-type)))
+
+(defun build-packages-compile-lisp (root)
+  "Byte-compile every file of lisp/ under ROOT, a warning counting as an error.
+Old .elc files are deleted first.  Signal an error naming every file that failed;
+the compiler's messages above it say why."
+  (let ((files (build-packages-lisp-files root))
+        (byte-compile-warnings t)
+        (byte-compile-error-on-warn t)
+        failed)
+    (dolist (file files)
+      (let ((elc (concat file "c")))
+        (when (file-exists-p elc)
+          (delete-file elc))))
+    (build-packages-lisp-prelude root)
+    (dolist (file files)
+      (unless (byte-compile-file file)
+        (push file failed)))
+    (when failed
+      (error "build-packages: %d own file(s) failed to compile (a warning is an error):\n  %s"
+             (length failed) (string-join (nreverse failed) "\n  ")))
+    (length files)))
+
 (defun build-packages-build (root)
-  "Build all packages of the repository at ROOT."
+  "Build all packages of the repository at ROOT, then the own modules in lisp/."
   (let* ((specs (build-packages-read-specs root))
@@ -401,6 +465,7 @@
       (build-packages-write-autoloads root specs (expand-file-name "autoloads.el" lib))
-      (message "build-packages: %d packages, %d patches in force, %d files compiled, \
-%d manuals"
-               (length specs) patches count
-               (build-packages-write-info root specs (expand-file-name "info" lib))))))
+      (let ((manuals (build-packages-write-info root specs (expand-file-name "info" lib)))
+            (own (build-packages-compile-lisp root)))
+        (message "build-packages: %d packages, %d patches in force, %d files compiled, \
+%d manuals, %d own files compiled"
+                 (length specs) patches count manuals own)))))
 
